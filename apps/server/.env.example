# Emails for Emergency (priority 1), Urgent (priority 2) and queue-position alerts.
# Alert emails go to each patient at the email they enter when booking (optional). ALERT_EMAIL_FROM is the sender. Leave SMTP_URL empty to only log the email (prototype default).
# To really send from Gmail: turn on 2-step verification, create an App Password, then set
#   SMTP_URL=smtps://godsont259%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
ALERT_EMAIL_FROM=SmartOPD <godsont259@gmail.com>
SMTP_URL=SMTP_URL=smtps://godsont259%40gmail.com:svzj bkum rqex xkfp@smtp.gmail.com:465

# Link placed in patient alert emails (defaults to the first WEB_ORIGIN). Set to your live site when hosted.
PUBLIC_WEB_URL=

# Number of worker threads that send emails in parallel (1-16)
MAIL_WORKERS=3
